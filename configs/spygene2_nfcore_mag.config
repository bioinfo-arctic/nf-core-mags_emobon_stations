/*
 * nf-core/mag configuration used for EMOBON metagenomic assemblies
 *
 * Pipeline version: nf-core/mag 5.3.0
 *
 * Designed for large co-assembled Illumina metagenomic datasets.
 * Resource values reflect experience running EMOBON datasets on spygene2
 * and may need adjustment on other systems.
 */

docker {
    enabled = true
    runOptions = '--ulimit nofile=65535:65535'
}

process {

    /*
     * MEGAHIT
     *
     * k=21 is excluded because very large EMOBON datasets caused extreme
     * memory consumption during the initial k=21 assembly stage.
     *
     * 1.2 TB RAM is allocated for the largest station datasets.
     */
    withName: MEGAHIT {
        cpus   = 32
        memory = 1200.GB
        time   = 360.d

        ext {
            args = "--k-list 29,39,59,79,99,119,141 -m ${task.memory.toBytes()}"
            prefix = { "MEGAHIT-${meta.id}" }
        }

        publishDir = [
            path: { "${params.outdir}/Assembly/MEGAHIT" },
            mode: 'copy',
            pattern: '*.{fa.gz,log}'
        ]
    }


    /*
     * Build Bowtie2 index from the assembly.
     *
     * bowtie2-build is effectively single-threaded in this pipeline step.
     * Large assemblies can require substantial RAM.
     */
    withName: 'NFCORE_MAG:MAG:BINNING_PREPARATION:SHORTREAD_BINNING_PREPARATION:BOWTIE2_ASSEMBLY_BUILD' {
        cpus   = 4
        memory = 256.GB
        time   = 96.h
    }


    /*
     * Map reads back to the assembly for coverage estimation.
     *
     * Increased from 4 to 16 CPUs because Bowtie2 alignment is one of the
     * major runtime bottlenecks for these very large read datasets.
     */
    withName: 'NFCORE_MAG:MAG:BINNING_PREPARATION:SHORTREAD_BINNING_PREPARATION:BOWTIE2_ASSEMBLY_ALIGN' {
        cpus   = 16
        memory = 512.GB
        time   = 96.h

        errorStrategy = {
            task.exitStatus in ((130..145) + 104 + 247) ? 'retry' : 'finish'
        }

        ext {
            args = ''
            prefix = { "${meta.id}.assembly" }
        }

        publishDir = [
            [
                path: { "${params.outdir}/Assembly/${assembly_meta.assembler}/QC/${assembly_meta.id}" },
                mode: 'copy',
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/Assembly/${assembly_meta.assembler}/QC/${assembly_meta.id}" },
                mode: 'copy',
                pattern: '*.{bam,bai}',
                enabled: false
            ]
        ]
    }


    /*
     * MetaBAT2 binning
     */
    withName: METABAT2_METABAT2 {
        cpus   = 16
        memory = 512.GB
        time   = 96.h

        ext {
            prefix = { "${meta.assembler}-MetaBAT2-${meta.id}" }
            args = '-m 1500 --unbinned --seed 1'
        }
    }


    /*
     * MetaBinner
     */
    withName: 'NFCORE_MAG:MAG:BINNING:BINNING_METABINNER:METABINNER_METABINNER' {
        cpus   = 16
        memory = 1200.GB
        time   = 750.h
    }


    withName: 'NFCORE_MAG:MAG:PRODIGAL' {
        cpus   = 1
        memory = 128.GB
        time   = 120.h
    }


    withName: 'NFCORE_MAG:MAG:PROKKA' {
        cpus   = 4
        memory = 32.GB
        time   = 48.h
    }
}
